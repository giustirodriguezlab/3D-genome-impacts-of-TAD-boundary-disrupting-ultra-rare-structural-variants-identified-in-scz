#!/usr/bin/env bash
set -euo pipefail

# Call A/B compartments with FAN-C at a selected resolution.
HIC_FILE="${HIC_FILE:?Set HIC_FILE to the input .hic file}"
OUT_DIR="${OUT_DIR:-fanc_compartments}"
RESOLUTION="${RESOLUTION:-1000000}"

mkdir -p "$OUT_DIR"
RES_KB=$((RESOLUTION / 1000))
HIC_AT_RES="${HIC_FILE}@${RES_KB}kb"

# Check syntax and optional arguments against your installed FAN-C version.
fanc compartments "$HIC_AT_RES" "${OUT_DIR}/compartments_${RES_KB}kb.ab"
